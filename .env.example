# =========================================================
# Adhook Employee Portal - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# =========================================================

APP_NAME="Adhook Employee Portal"
APP_URL=https://portal.adhookmedia.com
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_KEY=base64:CHANGE_ME_GENERATE_32_RANDOM_BYTES_BASE64

# -------------------- Database --------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=adhook_portal
DB_USER=adhook_portal_user
DB_PASS=

# -------------------- Mail (SMTP) ------------------------
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=noreply@adhookmedia.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_EMAIL=noreply@adhookmedia.com
MAIL_FROM_NAME="Adhook Employee Portal"

# -------------------- Web Push (VAPID) --------------------
# Generate with: php cron/generate_vapid_keys.php
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@adhookmedia.com

# -------------------- Session / Security -------------------
SESSION_NAME=adhook_portal_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# -------------------- Uploads -------------------------------
MAX_UPLOAD_MB=2

# -------------------- Cron secret ---------------------------
# Used to protect cron endpoints if triggered over HTTP instead of CLI
CRON_SECRET=CHANGE_ME_RANDOM_STRING
